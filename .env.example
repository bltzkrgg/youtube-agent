# AI Clipper Configuration
# Set to 'true' for testing without real downloads or API calls
DRY_RUN=true
NODE_ENV=development

# OpenRouter API key for LLM agents
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model per-agent (default: anthropic/claude-3-haiku if not set)
# See all models at: https://openrouter.ai/models
CLIP_PLANNER_MODEL=anthropic/claude-3-5-sonnet
METADATA_MODEL=anthropic/claude-3-haiku

# Telegram bot for clip review and approval
# Create bot via @BotFather to get token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Send message to @userinfobot to get your chat ID
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Enable or disable advanced processing agents
# Set to 'false' to disable (default: enabled)
ENABLE_MOMENT_SCORING=true
ENABLE_CRITIC=true
ENABLE_CAPTION_AGENT=true
ENABLE_REFRAME_AGENT=true

# ClipPlanner LLM resilience
# CLIP_PLANNER_REQUIRE_LLM=false  -- if false (default), fallback to heuristic clips on LLM failure
# CLIP_PLANNER_REQUIRE_LLM=true   -- if true, LLM failure fails the job
CLIP_PLANNER_REQUIRE_LLM=false

# Max clips per source video (hard cap applied after scoring, before DB insert and render enqueue)
# Set to 1 for testing, 3 for normal use
MAX_CLIPS_PER_SOURCE=3

# Clip boundary extension — avoids clips ending mid-sentence
# Seconds of silence/padding to add after the final segment
CLIP_END_PADDING_SECONDS=0.35
# Max seconds to extend end_sec to reach a sentence-ending punctuation (. ! ? …)
CLIP_END_SENTENCE_EXTENSION_SECONDS=3.0

# Clip duration constraints
# Clips shorter than min are repaired (expanded around midpoint) before being skipped
CLIP_MIN_DURATION_SECONDS=10
# Clips longer than max are trimmed around midpoint
CLIP_MAX_DURATION_SECONDS=60
# Target duration when repairing a short clip (must be >= CLIP_MIN_DURATION_SECONDS)
CLIP_TARGET_SHORT_REPAIR_SECONDS=12

# LLM timeouts (milliseconds)
# Main ClipPlanner LLM call timeout
CLIP_PLANNER_TIMEOUT_MS=90000
# Optional agent (critic/caption/reframe/scoring) timeout — shorter to avoid hanging
OPTIONAL_AGENT_TIMEOUT_MS=15000

# Whisper transcription model size
# Options: tiny, base, small, medium, large
# Larger models are more accurate but slower
WHISPER_MODEL=base

# Scene detection threshold
# Default: 27.0
# Lower values = more sensitive (more scenes detected)
SCENE_DETECT_THRESHOLD=27.0

# yt-dlp format string for video download
# Prefer 1080p mp4+m4a, fallback to best available 1080p, then global best
YTDLP_FORMAT=bestvideo[height<=1080][ext=mp4]+bestaudio[ext=m4a]/best[height<=1080][ext=mp4]/best

# Optional: Extract cookies from browser for age-restricted videos
# Options: chrome, firefox, safari, edge
# Leave commented out if not needed
# YTDLP_COOKIES_FROM_BROWSER=chrome

# Render quality settings (FFmpeg)
# CRF: lower = better quality, larger file. 18=near-lossless, 23=default, 28=fast/small
VIDEO_CRF=20
# Encoding preset: ultrafast veryfast fast medium slow veryslow (speed vs compression)
VIDEO_PRESET=veryfast
# Audio bitrate for final render
VIDEO_AUDIO_BITRATE=192k
# Scale algorithm for resize steps (lanczos=sharp, bicubic=fast)
VIDEO_SCALE_FLAGS=lanczos

# Face-aware vertical crop (optional)
# Uses OpenCV local face detection to center-crop on faces instead of frame center.
# Requires: pip install opencv-python
# Default: false — safe center crop, no OpenCV dependency
ENABLE_FACE_CROP=false

# Subtle continuous auto-zoom (Ken Burns effect)
# Applies a sinusoidal zoom to ALL clips, not just zoom_in strategy.
# Ported from errnex/auto-clip src/effects.py:render_vertical_clip.
# Default: false
ENABLE_KEN_BURNS=false

# Burn intro text overlay (first N seconds of clip)
# Text is derived from clip.title or caption_plan (when short and meaningful).
# Uses cross-platform font discovery (DejaVu / Liberation / Arial / Helvetica).
# Default: true (only triggers when intro text is available)
ENABLE_INTRO_TEXT=true
# How long the intro text stays visible (seconds)
INTRO_TEXT_DURATION=2.6

# Auto-Editor jump cut silence removal
# Requires: pip install auto-editor (https://auto-editor.com)
# Strips silent gaps (margin 0.2s) for tighter pacing.
# Default: false — graceful fallback to passthrough if auto-editor not in PATH
ENABLE_AUTO_EDITOR=false

# Caption/subtitle template
# Options: default | tiktok_bold | minimal
# default     — clean white text, black stroke, safe bottom margin
# tiktok_bold — large bold white + yellow highlight style, thick stroke
# minimal     — small grey text, no stroke, very bottom
CAPTION_TEMPLATE=default

# Maximum retry attempts for failed operations
MAX_RETRY=3

# Default timeout in milliseconds (30 minutes)
TIMEOUT_DEFAULT=1800000

# Output video dimensions (vertical format for TikTok/Shorts)
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30

# Directory paths (relative to project root)
OUTPUT_DIR=./output
CACHE_DIR=./cache
MEMORY_DIR=./memory
LOG_DIR=./logs

# Cache time-to-live in hours
CACHE_TTL_HOURS=6

# Days to keep rejected videos before cleanup
REJECTED_VIDEO_TTL_DAYS=7

# Legacy UGC Generator Pipeline (disabled by default)
# YOUTUBE_API_KEY=your_youtube_api_key_here
# RESEARCH_MODEL=anthropic/claude-3-haiku
# TTS_VOICE=id-ID-ArdiNeural
# TTS_RATE=+0%
# GOOGLE_API_KEY=your_google_api_key_here
# GOOGLE_VIDEO_MODEL=veo-1.0
# VISUAL_PROMPT_MODEL=google/gemini-flash-1.5
# BG_MUSIC_PATH=

